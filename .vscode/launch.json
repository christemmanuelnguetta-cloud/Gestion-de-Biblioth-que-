{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "BiblioIIT — interface graphique",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "BiblioIIT — console simple",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["--simple"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}
